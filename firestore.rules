// Regras do Firestore: cada usuário só enxerga e altera as próprias viagens
// (campo "uid" do documento) e as compras dessas viagens.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /viagens/{viagemId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;

      match /compras/{compraId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/viagens/$(viagemId)).data.uid
             == request.auth.uid;
      }
    }
  }
}
